# ==========================================
# JARVIS AI - Environment Configuration
# ==========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ==========================================
# Node & Application
# ==========================================
NODE_ENV=development
APP_NAME=jarvis-ai
APP_VERSION=0.1.0
LOG_LEVEL=debug

# ==========================================
# Backend Server
# ==========================================
BACKEND_PORT=3000
BACKEND_HOST=localhost
BACKEND_URL=http://localhost:3000
API_VERSION=v1

# ==========================================
# Frontend
# ==========================================
FRONTEND_PORT=5173
FRONTEND_HOST=localhost
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api

# ==========================================
# Database
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=jarvis_user
DB_PASSWORD=change_me_in_production
DB_NAME=jarvis_ai_dev
DB_LOGGING=true
DB_SYNCHRONIZE=false

# ==========================================
# Redis (Cache & Sessions)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ==========================================
# JWT & Authentication
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_REFRESH_EXPIRATION=7d
SESSION_SECRET=your_session_secret_change_this

# ==========================================
# OAuth & External Auth (Optional)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# ==========================================
# Security
# ==========================================
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true

# ==========================================
# File Upload
# ==========================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ==========================================
# Logging & Observability
# ==========================================
LOG_FORMAT=json
LOG_PATH=./logs
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==========================================
# Email (Optional)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@jarvis-ai.local
SMTP_TLS=true

# ==========================================
# AWS Services (Optional)
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=jarvis-ai-files

# ==========================================
# Stripe (Optional - Future)
# ==========================================
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==========================================
# Voice & Speech (Optional)
# ==========================================
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_SPEECH_API_KEY=
ELEVENLABS_API_KEY=

# ==========================================
# Debug Mode
# ==========================================
DEBUG=jarvis:*
VERBOSE_LOGGING=false
STACK_TRACE_ENABLED=true
